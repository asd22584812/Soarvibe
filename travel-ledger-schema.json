{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://soarvibe.app/schemas/travel-ledger/v1.json",
  "title": "SoarVibe Travel Ledger Store",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "ledgers"],
  "properties": {
    "version": {
      "type": "integer",
      "const": 1
    },
    "ledgers": {
      "type": "array",
      "items": { "$ref": "#/definitions/ledger" }
    },
    "updatedAt": {
      "type": ["string", "null"],
      "format": "date-time"
    }
  },
  "definitions": {
    "currencyCode": {
      "type": "string",
      "pattern": "^[A-Z]{3}$",
      "minLength": 3,
      "maxLength": 3
    },
    "dateOnly": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "isoDateTime": {
      "type": "string",
      "minLength": 10
    },
    "amountMinor": {
      "type": "integer",
      "minimum": 0
    },
    "nullableAmountMinor": {
      "type": ["integer", "null"],
      "minimum": 0
    },
    "currencyBlock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "symbol", "name", "minorUnitDigits"],
      "properties": {
        "code": { "$ref": "#/definitions/currencyCode" },
        "symbol": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "minorUnitDigits": { "type": "integer", "minimum": 0, "maximum": 4 }
      }
    },
    "expenseCategory": {
      "type": "string",
      "enum": [
        "food",
        "cafe",
        "shopping",
        "souvenir",
        "transport",
        "lodging",
        "ticket",
        "entertainment",
        "nightlife",
        "drugstore",
        "communication",
        "other"
      ]
    },
    "paymentMethod": {
      "type": "string",
      "enum": ["cash", "credit_card", "electronic", "other"]
    },
    "mood": {
      "type": "string",
      "enum": ["great", "good", "neutral", "bad"]
    },
    "ledgerStatus": {
      "type": "string",
      "enum": ["upcoming", "active", "ended", "archived"]
    },
    "cashAdjustmentType": {
      "type": "string",
      "enum": ["add", "subtract"]
    },
    "exchangeRateSource": {
      "type": "string",
      "enum": ["manual", "cache", "existing_soarvibe_fx", "unavailable"]
    },
    "expense": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "amountMinor",
        "currencyCode",
        "currencySymbol",
        "currencyMinorUnit",
        "convertedAmountMinor",
        "conversionCurrency",
        "conversionMinorUnit",
        "exchangeRateSnapshot",
        "exchangeRateSource",
        "category",
        "paymentMethod",
        "title",
        "note",
        "mood",
        "occurredAt",
        "createdAt",
        "updatedAt",
        "excludeFromBudget"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "amountMinor": { "$ref": "#/definitions/amountMinor" },
        "currencyCode": { "$ref": "#/definitions/currencyCode" },
        "currencySymbol": { "type": "string", "minLength": 1 },
        "currencyMinorUnit": { "type": "integer", "minimum": 0, "maximum": 4 },
        "convertedAmountMinor": { "$ref": "#/definitions/nullableAmountMinor" },
        "conversionCurrency": { "$ref": "#/definitions/currencyCode" },
        "conversionMinorUnit": { "type": "integer", "minimum": 0, "maximum": 4 },
        "exchangeRateSnapshot": { "type": ["number", "null"] },
        "exchangeRateSource": { "$ref": "#/definitions/exchangeRateSource" },
        "category": { "$ref": "#/definitions/expenseCategory" },
        "categoryLabel": { "type": "string" },
        "categoryIcon": { "type": "string" },
        "paymentMethod": { "$ref": "#/definitions/paymentMethod" },
        "title": { "type": "string" },
        "note": { "type": "string" },
        "mood": { "type": ["string", "null"], "enum": ["great", "good", "neutral", "bad", null] },
        "occurredAt": { "$ref": "#/definitions/isoDateTime" },
        "createdAt": { "$ref": "#/definitions/isoDateTime" },
        "updatedAt": { "$ref": "#/definitions/isoDateTime" },
        "excludeFromBudget": { "type": "boolean" }
      }
    },
    "cashAdjustment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "amountMinor",
        "currencyCode",
        "type",
        "reason",
        "occurredAt",
        "createdAt",
        "updatedAt"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "amountMinor": { "$ref": "#/definitions/amountMinor" },
        "currencyCode": { "$ref": "#/definitions/currencyCode" },
        "type": { "$ref": "#/definitions/cashAdjustmentType" },
        "reason": { "type": "string" },
        "occurredAt": { "$ref": "#/definitions/isoDateTime" },
        "createdAt": { "$ref": "#/definitions/isoDateTime" },
        "updatedAt": { "$ref": "#/definitions/isoDateTime" }
      }
    },
    "ledger": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "countryCode",
        "countryName",
        "cityName",
        "emoji",
        "startDate",
        "endDate",
        "status",
        "primaryCurrency",
        "displayCurrency",
        "budgetMinor",
        "initialCashMinor",
        "manualExchangeRate",
        "expenses",
        "cashAdjustments",
        "createdAt",
        "updatedAt"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "countryCode": { "type": "string", "minLength": 2, "maxLength": 3 },
        "countryName": { "type": "string", "minLength": 1 },
        "cityName": { "type": "string" },
        "emoji": { "type": "string", "minLength": 1 },
        "startDate": { "$ref": "#/definitions/dateOnly" },
        "endDate": { "$ref": "#/definitions/dateOnly" },
        "status": { "$ref": "#/definitions/ledgerStatus" },
        "primaryCurrency": { "$ref": "#/definitions/currencyBlock" },
        "displayCurrency": { "$ref": "#/definitions/currencyBlock" },
        "budgetMinor": { "$ref": "#/definitions/nullableAmountMinor" },
        "initialCashMinor": { "$ref": "#/definitions/nullableAmountMinor" },
        "manualExchangeRate": { "type": ["number", "null"], "exclusiveMinimum": 0 },
        "expenses": {
          "type": "array",
          "items": { "$ref": "#/definitions/expense" }
        },
        "cashAdjustments": {
          "type": "array",
          "items": { "$ref": "#/definitions/cashAdjustment" }
        },
        "createdAt": { "$ref": "#/definitions/isoDateTime" },
        "updatedAt": { "$ref": "#/definitions/isoDateTime" }
      }
    }
  }
}
